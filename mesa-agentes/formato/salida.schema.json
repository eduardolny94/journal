{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ficha diaria de la mesa de agentes",
  "type": "object",
  "required": ["fecha", "agente", "version_fichas", "pares", "eventos"],
  "properties": {
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "agente": { "type": "string", "enum": ["analista_macro", "analista_flujos", "jefe_de_mesa"] },
    "version_fichas": { "type": "string", "description": "Versión de fichas/divisas.md usada (cambia con el cuaderno)" },
    "pares": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "sesgo", "confianza", "motivos", "invalidacion", "coincide_radar"],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Z]{6}$" },
          "sesgo": { "type": "integer", "minimum": -2, "maximum": 2, "description": "+2 base muy fuerte … −2 cotizada muy fuerte" },
          "confianza": { "type": "integer", "minimum": 0, "maximum": 100 },
          "horizonte_dias": { "type": "integer", "enum": [1, 5, 20], "default": 5 },
          "motivos": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 200 } },
          "invalidacion": { "type": "string", "maxLength": 200, "description": "Nivel o evento que anularía el sesgo" },
          "evento_clave": { "type": "string", "maxLength": 120 },
          "coincide_radar": { "type": "boolean" },
          "discrepancia": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["titulo", "divisa", "tono", "cambia_expectativas", "lectura"],
        "properties": {
          "titulo": { "type": "string" },
          "divisa": { "type": "string" },
          "tono": { "type": "integer", "minimum": -2, "maximum": 2, "description": "hawkish +2 … dovish −2 frente a lo descontado" },
          "cambia_expectativas": { "type": "boolean" },
          "confirmacion": { "type": "object", "properties": { "bono_2a": { "type": "string" }, "dxy": { "type": "string" }, "oro_nasdaq": { "type": "string" } } },
          "lectura": { "type": "string", "maxLength": 600 }
        }
      }
    },
    "nota_jefe": { "type": "string", "maxLength": 800 }
  }
}
