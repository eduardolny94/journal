# Copia este archivo a .env y ajusta los valores
# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Puerto del servidor API (API_PORT tiene prioridad sobre PORT)
API_PORT=3200
PORT=3200
# (Opcional) Ruta del archivo SQLite. Por defecto: server/data/journal.db
# JOURNAL_DB=./data/journal.db
# (Opcional) Entorno: production activa cookies Secure y exige JWT_SECRET
# NODE_ENV=production
# (Opcional) Orígenes externos permitidos (separados por coma) si el cliente se sirve desde otro dominio
# CORS_ORIGIN=https://mi-journal.com
# (Opcional) 1 si el servidor está detrás de un proxy (Railway, Render, Nginx) para que el límite por IP funcione
# TRUST_PROXY=1

# Clave gratuita de FRED (fred.stlouisfed.org) para el Radar de divisas
FRED_API_KEY=

# Carpeta MQL5\Files de tu MetaTrader 5 (Archivo -> Abrir carpeta de datos -> MQL5 -> Files). El servicio RadarPrecios escribe ahi radar\precios.json
MT5_FILES_DIR=

# Emails (separados por coma) que pueden ver la pestaña privada Radar
RADAR_OWNER_EMAILS=
