//@version=6
// GTFX · Señal a Discord
// Escribes la operación en Entradas (entrada, stop, TP1, TP2), el indicador la dibuja como la herramienta de
// posición y, con una alerta de TradingView con webhook a Discord, publica la señal y después avisa de entrada, TP1, TP2
// o stop. Pasos en la descripción de la descarga del journal.
indicator("GTFX · Señal a Discord", overlay = true, max_boxes_count = 10, max_labels_count = 20, max_lines_count = 10)

// ── Operación: TradingView te pide un clic en el gráfico para cada precio
G1 = "Operación (escribe los precios)"
pEntrada = input.price(0, "Entrada", group = G1)
pSL      = input.price(0, "Stop (SL)", group = G1)
pTP1     = input.price(0, "TP1", group = G1)
pTP2     = input.price(0, "TP2", group = G1)
tipo     = input.string("Ahora (mercado)", "Tipo de entrada", options = ["Ahora (mercado)", "Límite (esperar el precio)"], group = G1)

// ── Mensaje
G2 = "Mensaje"
activoIn = input.string("", "Nombre del activo (vacío = automático: Gold, Silver, US30…)", group = G2)
cerca    = input.string("(o cercano)", "Texto junto a la entrada", group = G2)
idioma   = input.string("SELL / BUY", "Acción", options = ["SELL / BUY", "VENTA / COMPRA"], group = G2)
nota     = input.string("", "Nota (opcional, p. ej. -Raid)", group = G2)
pie      = input.string("⚠️ Gestiona tu riesgo", "Última línea de la señal (vacío = sin ella)", group = G2)
mencion  = input.string("", "Mención (opcional, p. ej. @everyone)", group = G2)
formato  = input.string("Discord", "Formato", options = ["Discord", "Texto"], tooltip = "Discord: el mensaje va en JSON, como lo pide el webhook de Discord. Texto: para Telegram u otros.", group = G2)
seguir   = input.bool(true, "Avisar también de entrada, TP1, TP2 y stop", group = G2)
G3 = "Dibujo"
barras   = input.int(30, "Ancho de las cajas (velas)", minval = 5, maxval = 300, group = G3)
lineas   = input.bool(true, "Líneas de entrada, SL y TP extendidas a la derecha", group = G3)
cEntrada = input.color(color.new(#2962ff, 0), "Colores de líneas: entrada / SL / TP", inline = "l", group = G3)
cSL      = input.color(color.new(#f23645, 0), "", inline = "l", group = G3)
cTP      = input.color(color.new(#089981, 0), "", inline = "l", group = G3)
cRojo    = input.color(color.new(#f23645, 78), "Colores: riesgo / beneficio", inline = "c", group = G3)
cVerde   = input.color(color.new(#089981, 78), "", inline = "c", group = G3)

// ── Datos de la operación
esVenta = pSL > pEntrada
// ¿Los precios son de este par? Si cambias de par, los precios del anterior quedan lejísimos (p. ej. 0,83 en el oro): sin señal.
enEstePar = pEntrada > 0 and math.abs(pEntrada - close) / close <= 0.08
valida  = enEstePar and (esVenta ? (pTP2 < pTP1 and pTP1 < pEntrada and pEntrada < pSL) : (pTP2 > pTP1 and pTP1 > pEntrada and pEntrada > pSL))
riesgo  = math.abs(pEntrada - pSL)
rr(p)   => riesgo > 0 ? math.abs(p - pEntrada) / riesgo : 0.0
f(x)    => str.tostring(math.round_to_mintick(x))
lado    = idioma == "SELL / BUY" ? (esVenta ? "SELL" : "BUY") : (esVenta ? "VENTA" : "COMPRA")
nombreAuto() =>
    t = syminfo.ticker
    if str.contains(t, "XAU") or t == "GOLD"
        "Gold"
    else if str.contains(t, "XAG") or t == "SILVER"
        "Silver"
    else if str.contains(t, "BTC")
        "Bitcoin"
    else if t == "US30" or str.contains(t, "DJI") or str.startswith(t, "YM")
        "US30"
    else if str.contains(t, "NAS") or str.contains(t, "NDX") or str.startswith(t, "NQ")
        "Nasdaq"
    else if str.contains(t, "SPX") or t == "US500" or str.startswith(t, "ES1")
        "S&P 500"
    else
        t
activo  = activoIn != "" ? activoIn : nombreAuto()
esAhora = tipo == "Ahora (mercado)"

// Mensaje: en JSON para Discord (escapando comillas y barras) o en texto plano.
esc(s) => str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\"")
mensaje(array<string> lineas) =>
    string out = ""
    if formato == "Discord"
        string cuerpo = mencion != "" ? esc(mencion) + "\\n" : ""
        for [i, l] in lineas
            cuerpo += (i > 0 ? "\\n" : "") + esc(l)
        out := "{\"content\":\"" + cuerpo + "\"}"
    else
        string cuerpo = mencion != "" ? mencion + "\n" : ""
        for [i, l] in lineas
            cuerpo += (i > 0 ? "\n" : "") + l
        out := cuerpo
    out

senal() =>
    array<string> l = array.new<string>()
    string ahora = idioma == "SELL / BUY" ? (esAhora ? " NOW" : " LIMIT") : (esAhora ? " AHORA" : " LÍMITE")
    l.push((esVenta ? "🔴 " : "🟢 ") + "**" + lado + " " + activo + ahora + "**")
    l.push(activo + " Entrada: " + f(pEntrada) + (cerca != "" ? " " + cerca : ""))
    l.push("SL: " + f(pSL))
    l.push("TP1: " + f(pTP1) + "  (" + str.tostring(rr(pTP1), "#.#") + "R)")
    l.push("TP2: " + f(pTP2) + "  (" + str.tostring(rr(pTP2), "#.#") + "R)")
    if nota != ""
        l.push(nota)
    if pie != ""
        l.push(pie)
    mensaje(l)

aviso(string titulo) =>
    array<string> l = array.new<string>()
    l.push(titulo + " · " + activo)
    l.push(lado + " " + activo + " · Entrada " + f(pEntrada) + " · SL " + f(pSL) + " · TP1 " + f(pTP1) + " · TP2 " + f(pTP2))
    mensaje(l)

// ── Seguimiento: 0 esperando la entrada · 1 en curso · 2 TP1 tocado · 3 TP2 (cerrada) · 4 stop (cerrada)
var int estado = -1
var int barIni = na
empieza = valida and estado == -1 and barstate.islast
if empieza
    barIni := bar_index
if empieza
    estado := esAhora ? 1 : 0

string evento = ""
if valida and estado >= 0 and estado <= 2 and not empieza
    tocaEntrada = esVenta ? high >= pEntrada : low <= pEntrada
    tocaSL      = esVenta ? high >= pSL : low <= pSL
    tocaTP1     = esVenta ? low <= pTP1 : high >= pTP1
    tocaTP2     = esVenta ? low <= pTP2 : high >= pTP2
    if estado == 0 and tocaEntrada
        estado := 1
        evento := "▶️ Entrada activada"
    else if estado >= 1 and tocaSL
        // si en la misma vela tocan stop y objetivo, se cuenta el stop (lo prudente)
        estado := 4
        evento := "❌ Stop tocado"
    else if estado >= 1 and tocaTP2
        estado := 3
        evento := "🎯 TP2 alcanzado (" + str.tostring(rr(pTP2), "#.#") + "R)"
    else if estado == 1 and tocaTP1
        estado := 2
        evento := "✅ TP1 alcanzado (" + str.tostring(rr(pTP1), "#.#") + "R)"

// ── Alertas (solo en tiempo real). La señal sale una vez al activar la alerta; los avisos, una vez por vela.
varip bool publicada = false
if barstate.isrealtime and valida and not publicada and estado >= 0 and estado <= 2
    publicada := true
    alert(senal(), alert.freq_once_per_bar)
if barstate.isrealtime and seguir and evento != ""
    alert(aviso(evento), alert.freq_once_per_bar)

// ── Dibujo, como la herramienta de posición
var box bRiesgo = na
var box bBenef  = na
var line lTP1   = na
var line lnE    = na
var line lnS    = na
var line ln1    = na
var line ln2    = na
var label lbE   = na
var label lbS   = na
var label lb1   = na
var label lb2   = na
var label lbN   = na
var label lbAyuda = na
if barstate.islast
    label.delete(lbAyuda)
    if not enEstePar
        lbAyuda := label.new(bar_index + 3, close, "📍 GTFX Señal: sin operación en " + activo + ". Doble clic en «GTFX · Señal a Discord» → Entradas y pon entrada, SL, TP1 y TP2", style = label.style_label_left, color = color.new(#2962ff, 15), textcolor = color.white, size = size.small)
if barstate.islast and enEstePar
    box.delete(bRiesgo), box.delete(bBenef), line.delete(lTP1), line.delete(lnE), line.delete(lnS), line.delete(ln1), line.delete(ln2)
    label.delete(lbE), label.delete(lbS), label.delete(lb1), label.delete(lb2), label.delete(lbN)
    int t1 = na(barIni) ? bar_index : barIni
    int t2 = t1 + barras
    bRiesgo := box.new(t1, math.max(pEntrada, pSL), t2, math.min(pEntrada, pSL), xloc = xloc.bar_index, border_color = color.new(#f23645, 40), bgcolor = cRojo)
    bBenef  := box.new(t1, math.max(pEntrada, pTP2), t2, math.min(pEntrada, pTP2), xloc = xloc.bar_index, border_color = color.new(#089981, 40), bgcolor = cVerde)
    lTP1    := line.new(t1, pTP1, t2, pTP1, xloc = xloc.bar_index, color = color.new(#089981, 0), style = line.style_dashed, width = 1)
    if lineas
        lnE := line.new(t1, pEntrada, t2, pEntrada, xloc = xloc.bar_index, extend = extend.right, color = cEntrada, width = 2)
        lnS := line.new(t1, pSL, t2, pSL, xloc = xloc.bar_index, extend = extend.right, color = cSL, width = 2)
        ln1 := line.new(t1, pTP1, t2, pTP1, xloc = xloc.bar_index, extend = extend.right, color = cTP, width = 1, style = line.style_dashed)
        ln2 := line.new(t1, pTP2, t2, pTP2, xloc = xloc.bar_index, extend = extend.right, color = cTP, width = 2)
    string est = not valida ? "⚠ Revisa los precios (el stop y los TP deben ir a cada lado de la entrada, TP1 antes que TP2)" : estado == 0 ? "esperando la entrada" : estado == 1 ? "en curso" : estado == 2 ? "TP1 ✓" : estado == 3 ? "TP2 ✓ · cerrada" : estado == 4 ? "stop · cerrada" : "lista"
    lbE := label.new(t2, pEntrada, lado + " @" + f(pEntrada) + (est != "" ? "  ·  " + est : ""), xloc = xloc.bar_index, style = label.style_label_left, color = cEntrada, textcolor = valida ? color.white : color.orange, size = size.small)
    lbS := label.new(t2, pSL, "SL " + f(pSL), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(#f23645, 15), textcolor = color.white, size = size.small)
    lb1 := label.new(t2, pTP1, "TP1 " + f(pTP1) + " · " + str.tostring(rr(pTP1), "#.#") + "R", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(#089981, 30), textcolor = color.white, size = size.small)
    lb2 := label.new(t2, pTP2, "TP2 " + f(pTP2) + " · " + str.tostring(rr(pTP2), "#.#") + "R", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(#089981, 15), textcolor = color.white, size = size.small)
    if nota != ""
        lbN := label.new(t1, esVenta ? math.max(pSL, pEntrada) : math.min(pSL, pEntrada), nota, xloc = xloc.bar_index, style = esVenta ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.gray, size = size.small)
